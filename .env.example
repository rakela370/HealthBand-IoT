# HealthBand
HEALTHBAND_DEVICE_ID=healthband-device-001
HEALTHBAND_USER_ID=simulated-user-001

# Application
APP_ENV=development
LOG_LEVEL=INFO

# AWS
AWS_REGION=eu-central-1
AWS_PROFILE=default

# Device AWS IoT
AWS_IOT_ENDPOINT=YOUR_ENDPOINT-ats.iot.eu-central-1.amazonaws.com
AWS_IOT_CERT_PATH=certificates/healthband-device-001/device.pem.crt
AWS_IOT_PRIVATE_KEY_PATH=certificates/healthband-device-001/private.pem.key
AWS_ROOT_CA_PATH=certificates/healthband-device-001/AmazonRootCA1.pem

# FastAPI backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_MQTT_ENABLED=true

# Dedicated backend MQTT identity
BACKEND_MQTT_CLIENT_ID=healthband-control-backend
BACKEND_IOT_CERT_PATH=certificates/healthband-control-backend/backend.pem.crt
BACKEND_IOT_PRIVATE_KEY_PATH=certificates/healthband-control-backend/backend.private.key
BACKEND_ROOT_CA_PATH=certificates/healthband-control-backend/AmazonRootCA1.pem

# DynamoDB
DYNAMODB_TELEMETRY_TABLE=HealthBandTelemetry
DYNAMODB_ANALYTICS_TABLE=HealthBandAnalytics
DYNAMODB_EVENTS_TABLE=HealthBandEvents

# CORS
BACKEND_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# AWS IoT Jobs / OTA
OTA_S3_BUCKET=healthband-ota-YOUR_AWS_ACCOUNT_ID-eu-central-1
OTA_S3_PREFIX=releases
OTA_IOT_JOBS_ROLE_ARN=arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/HealthBandIoTJobsS3Role
OTA_PRESIGNED_URL_EXPIRES_SEC=900
OTA_UPDATE_TIMEOUT_SEC=300
OTA_ARTIFACTS_ROOT=ota_artifacts
OTA_RESOURCE_STATE_PATH=runtime/ota_aws_resources.json