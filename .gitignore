# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Testing
.pytest_cache/
.coverage
htmlcov/

# Environment variables
.env
.env.*
!.env.example

# AWS / certificates / secrets
certificates/
*.key
*.p12
*.pfx

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Runtime files
runtime/
tmp/
temp/

# Downloaded OTA files
ota_downloads/
ota_artifacts/*.zip

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Generated local AWS policy files
infrastructure/iot_policies/*.local.json

# Generated local AWS IoT Rule files
infrastructure/iot_rules/*.local.json

# FastAPI backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_MQTT_ENABLED=true

# Dedicated backend MQTT identity
BACKEND_MQTT_CLIENT_ID=healthband-control-backend
BACKEND_IOT_CERT_PATH=certificates/healthband-control-backend/backend.pem.crt
BACKEND_IOT_PRIVATE_KEY_PATH=certificates/healthband-control-backend/backend.private.key
BACKEND_ROOT_CA_PATH=certificates/healthband-control-backend/AmazonRootCA1.pem

# DynamoDB
DYNAMODB_TELEMETRY_TABLE=HealthBandTelemetry
DYNAMODB_ANALYTICS_TABLE=HealthBandAnalytics
DYNAMODB_EVENTS_TABLE=HealthBandEvents

# Development frontend origins
BACKEND_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# OTA runtime installation state
releases/
.ota_staging/
ota_downloads/

# Temporary OTA extraction directories
ota_artifacts/**/.bootstrap_staging/