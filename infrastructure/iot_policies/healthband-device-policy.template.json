{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectAsOwnThing",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:eu-central-1:YOUR_AWS_ACCOUNT_ID:client/${iot:Connection.Thing.ThingName}",
      "Condition": {
        "Bool": {
          "iot:Connection.Thing.IsAttached": "true"
        }
      }
    },
    {
      "Sid": "PublishHealthBandDataAndShadows",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:eu-central-1:YOUR_AWS_ACCOUNT_ID:topic/healthband/${iot:Connection.Thing.ThingName}/*",
        "arn:aws:iot:eu-central-1:YOUR_AWS_ACCOUNT_ID:topic/$aws/things/${iot:Connection.Thing.ThingName}/shadow/*"
      ]
    },
    {
      "Sid": "SubscribeToCommandsAndShadows",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:eu-central-1:YOUR_AWS_ACCOUNT_ID:topicfilter/healthband/${iot:Connection.Thing.ThingName}/commands/request",
        "arn:aws:iot:eu-central-1:YOUR_AWS_ACCOUNT_ID:topicfilter/$aws/things/${iot:Connection.Thing.ThingName}/shadow/*"
      ]
    },
    {
      "Sid": "ReceiveCommandsAndShadows",
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:eu-central-1:YOUR_AWS_ACCOUNT_ID:topic/healthband/${iot:Connection.Thing.ThingName}/commands/request",
        "arn:aws:iot:eu-central-1:YOUR_AWS_ACCOUNT_ID:topic/$aws/things/${iot:Connection.Thing.ThingName}/shadow/*"
      ]
    }
  ]
}