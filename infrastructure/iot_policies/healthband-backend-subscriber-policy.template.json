{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackendConnect",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:client/YOUR_BACKEND_CLIENT_ID"
    },
    {
      "Sid": "BackendSubscribe",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topicfilter/healthband/YOUR_THING_NAME/telemetry",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topicfilter/healthband/YOUR_THING_NAME/analytics",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topicfilter/healthband/YOUR_THING_NAME/alerts",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topicfilter/healthband/YOUR_THING_NAME/health",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topicfilter/healthband/YOUR_THING_NAME/events",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topicfilter/healthband/YOUR_THING_NAME/commands/response",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topicfilter/healthband/YOUR_THING_NAME/presence",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topicfilter/healthband/YOUR_THING_NAME/ota/status"
      ]
    },
    {
      "Sid": "BackendReceive",
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topic/healthband/YOUR_THING_NAME/telemetry",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topic/healthband/YOUR_THING_NAME/analytics",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topic/healthband/YOUR_THING_NAME/alerts",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topic/healthband/YOUR_THING_NAME/health",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topic/healthband/YOUR_THING_NAME/events",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topic/healthband/YOUR_THING_NAME/commands/response",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topic/healthband/YOUR_THING_NAME/presence",
        "arn:aws:iot:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:topic/healthband/YOUR_THING_NAME/ota/status"
      ]
    }
  ]
}