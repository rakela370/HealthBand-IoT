{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "iot.amazonaws.com"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
                "StringEquals": {
                    "aws:SourceAccount": "748439418076"
                },
                "ArnLike": {
                    "aws:SourceArn": "arn:aws:iot:eu-central-1:748439418076:job/*"
                }
            }
        }
    ]
}
